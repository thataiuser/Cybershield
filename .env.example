MONGODB_URI=mongodb://127.0.0.1:27017/cybershield
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
# Anyone who registers with this email becomes an admin
ADMIN_EMAIL=you@example.com
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Public address of your site (used in password-reset links)
APP_URL=http://localhost:3000
# Email for password resets. Leave SMTP_HOST empty to print reset links in the server console (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CyberShield <no-reply@yourdomain.com>"

# Courses unlock one day at a time. Set to true to open all 30 days at once (handy for demos and testing).
UNLOCK_ALL=false

# Shown in the welcome email, the welcome page and the footer
FOUNDER_NAME=Eta Orock Dobgima
FOUNDER_TITLE=Creator & Manager, CyberShield
# LOCAL TESTING ONLY: returns the verification code in the API response. Never enable in production.
SHOW_CODE_IN_RESPONSE=false
